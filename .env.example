# Variables de entorno para ejecutar SIGE localmente con Docker Compose.
# Copiar a .env y ajustar segun el entorno. No versionar el archivo .env real.

# Conexion al contenedor MySQL YA EXISTENTE en Docker (no lo levanta este compose).
SIGE_DB_CONNECTION=Server=host.docker.internal;Port=3306;Database=SigeDb;User=sige_app;Password=CHANGE_ME;

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080

# Base URL de la API que consume el frontend Angular.
SIGE_API_BASE_URL=http://localhost:8080

# Contrasena de las cuentas demo generadas automaticamente (FR-122), solo en
# Development/Demo/Testing. Nunca se usa en Production. No es un secreto real:
# si no se define, el codigo usa el default "DemoSige#2026" documentado en
# specs/002-ampliacion-operativa-nacional (seccion 19.2 del documento de origen).
SIGE_DEMO_PASSWORD=DemoSige#2026
